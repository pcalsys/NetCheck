<Window x:Class="NetCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}"
        Language="{Binding CurrentLanguageTag, Mode=OneWay, ConverterCulture=en-US}"
        Width="1240"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,30,0,0">
                    <TextBlock Text="{DynamicResource NavigationLabel}" Foreground="#68778F" FontSize="9" FontWeight="Bold"
                               Margin="27,0,0,9" TextWrapping="NoWrap" />
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowDashboardCommand}"
                            Tag="{Binding IsDashboardSelected}"
                            AutomationProperties.Name="{DynamicResource DashboardMenu}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding DashboardMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowSpeedTestCommand}"
                            Tag="{Binding IsSpeedTestSelected}"
                            AutomationProperties.Name="{DynamicResource SpeedTestAutomationName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding SpeedTestMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowHistoryCommand}"
                            Tag="{Binding IsHistorySelected}"
                            AutomationProperties.Name="{DynamicResource HistoryAutomationName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding HistoryMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            Tag="{Binding IsSettingsSelected}"
                            AutomationProperties.Name="{DynamicResource SettingsMenu}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding SettingsMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="{DynamicResource CreatorCredit}" Foreground="White"
                           FontSize="11" FontWeight="SemiBold" Margin="24,12,18,12" />

                <StackPanel Grid.Row="3" Margin="18,4,18,8">
                    <TextBlock Text="{DynamicResource MenuLanguage}" Foreground="#AEBBD0" FontSize="9" FontWeight="Bold"
                               Margin="4,0,0,7" TextWrapping="NoWrap" />
                    <Border Background="#121E30" CornerRadius="9" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding UseEnglishMenuCommand}"
                                    Tag="{Binding IsEnglishMenu}" Style="{StaticResource LanguageButtonStyle}"
                                    AutomationProperties.Name="{DynamicResource UseEnglishMenuAutomation}">
                                <TextBlock Text="English" Foreground="White" />
                            </Button>
                            <Button Grid.Column="1" Command="{Binding UseGermanMenuCommand}"
                                    Tag="{Binding IsGermanMenu}" Style="{StaticResource LanguageButtonStyle}"
                                    AutomationProperties.Name="{DynamicResource UseGermanMenuAutomation}">
                                <TextBlock Text="Deutsch" Foreground="White" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="VERSION 1.0" Foreground="#718099" FontSize="8" FontWeight="Bold"
                           Margin="24,5,0,20" TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <TextBlock Text="{Binding CurrentPageName}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
