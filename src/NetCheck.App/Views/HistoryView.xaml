<UserControl x:Class="NetCheck.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Diagnostic history">
    <Grid Margin="34,28,34,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="YOUR REPORTS" Style="{StaticResource PageEyebrowStyle}" />
                <TextBlock Text="A clear record of every check" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                <TextBlock Text="Compare past diagnoses, revisit the evidence, or export a report when you need help."
                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18,0,0,1">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" AutomationProperties.Name="Refresh diagnostic history">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Margin="0,0,7,0" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Refresh" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Clear diagnostic history">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Margin="0,0,7,0" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="Clear history" TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                Visibility="{Binding HasReports, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource PrimarySoftBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="26"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                </Border>
                <TextBlock Text="Your history is ready when you are" FontFamily="{StaticResource DisplayFont}"
                           FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Complete a network check and its diagnosis will appear here automatically. Reports stay on this computer."
                           Style="{StaticResource MutedTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasReports, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,6,8,13">
                        <TextBlock Text="RECENT DIAGNOSTICS" Style="{StaticResource MetricLabelStyle}" />
                        <Border HorizontalAlignment="Right" Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="10" Padding="8,3">
                            <TextBlock Text="{Binding Reports.Count}" Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="10" FontWeight="Bold" TextWrapping="NoWrap" />
                        </Border>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Reports}"
                             SelectedItem="{Binding SelectedReport}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Padding="13" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="11"
                                                Background="{Binding Diagnosis.Outcome, Converter={StaticResource OutcomeToTintBrushConverter}}"
                                                VerticalAlignment="Top">
                                            <Ellipse Width="9" Height="9"
                                                     Fill="{Binding Diagnosis.Outcome, Converter={StaticResource OutcomeToBrushConverter}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Diagnosis.Headline}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding CompletedAtUtc, StringFormat={}{0:MMM d, yyyy · HH:mm}}"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                                                       Margin="0,3,0,0" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                   Foreground="{StaticResource SoftTextBrush}" FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedReport}" Margin="24">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Background="{Binding Diagnosis.Outcome, Converter={StaticResource OutcomeToTintBrushConverter}}"
                                            CornerRadius="10" Padding="9,4">
                                        <TextBlock Text="DIAGNOSIS" Foreground="{Binding Diagnosis.Outcome, Converter={StaticResource OutcomeToBrushConverter}}"
                                                   FontSize="9" FontWeight="Bold" TextWrapping="NoWrap" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Diagnosis.Headline}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Diagnosis.Summary}" Style="{StaticResource MutedTextStyle}"
                                           Margin="0,5,30,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top"
                                    AutomationProperties.Name="Export selected report">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Margin="0,0,7,0" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Export report" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource SoftCardStyle}" Padding="16" Margin="0,0,0,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="IP ADDRESS" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding Network.PrimaryIpAddress}" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock Text="GATEWAY" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding Network.PrimaryGateway}" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DURATION" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat={}{0:0.0} seconds}" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Checks in this report" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="9"
                                                Background="{Binding Status, Converter={StaticResource OutcomeToBrushConverter}}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,14,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource StatusToLabelConverter}}"
                                                   Foreground="{Binding Status, Converter={StaticResource OutcomeToBrushConverter}}"
                                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
