<Application x:Class="NetCheck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NetCheck.App.Converters"
             xmlns:viewModels="clr-namespace:NetCheck.App.ViewModels"
             xmlns:views="clr-namespace:NetCheck.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Strings.en.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
            <converters:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
            <converters:OutcomeToBrushConverter x:Key="OutcomeToBrushConverter" />
            <converters:OutcomeToTintBrushConverter x:Key="OutcomeToTintBrushConverter" />
            <converters:StatusToGlyphConverter x:Key="StatusToGlyphConverter" />
            <converters:StatusToLabelConverter x:Key="StatusToLabelConverter" />
            <converters:CompletedCountConverter x:Key="CompletedCountConverter" />
            <converters:DurationMillisecondsConverter x:Key="DurationMillisecondsConverter" />
            <converters:DurationSecondsConverter x:Key="DurationSecondsConverter" />
            <converters:DateTimeTextConverter x:Key="DateTimeTextConverter" />
            <converters:LocalizedTextConverter x:Key="LocalizedTextConverter" />

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SpeedTestViewModel}">
                <views:SpeedTestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MonitoringViewModel}">
                <views:MonitoringView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
