<Window x:Class="NetCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetCheck · Network diagnostics"
        Width="1240"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,26,18,32">
                    <Border Width="42" Height="42" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7287F5" Offset="0" />
                                <GradientStop Color="#4B68E8" Offset="0.55" />
                                <GradientStop Color="#2AA5A0" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
                            <Ellipse Width="6" Height="6" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" />
                            <TextBlock Text="N" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NetCheck" Foreground="White" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="NETWORK CLARITY" Foreground="#8291A9" FontSize="8" FontWeight="Bold"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding NavigationLabel}" Foreground="#68778F" FontSize="9" FontWeight="Bold"
                               Margin="27,0,0,9" TextWrapping="NoWrap" />
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowDashboardCommand}"
                            Tag="{Binding IsDashboardSelected}"
                            AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding DashboardMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowHistoryCommand}"
                            Tag="{Binding IsHistorySelected}"
                            AutomationProperties.Name="Diagnostic history">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding HistoryMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            Tag="{Binding IsSettingsSelected}"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding SettingsMenuLabel}"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Margin="18,12,18,12" Padding="14" CornerRadius="12"
                        Background="{StaticResource SidebarSurfaceBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#243B44" VerticalAlignment="Top">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="#67D6B0"
                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="You stay in control" Foreground="#E8EDF6" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Checks are read-only. Repairs run only after your approval."
                                       Foreground="#8796AC" FontSize="10" LineHeight="15" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Margin="18,4,18,8">
                    <TextBlock Text="{Binding MenuLanguageLabel}" Foreground="#78879E" FontSize="9" FontWeight="Bold"
                               Margin="4,0,0,7" TextWrapping="NoWrap" />
                    <Border Background="#121E30" CornerRadius="9" Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="English" Command="{Binding UseEnglishMenuCommand}"
                                    Tag="{Binding IsEnglishMenu}" Style="{StaticResource LanguageButtonStyle}"
                                    AutomationProperties.Name="Use English menu" />
                            <Button Grid.Column="1" Content="Deutsch" Command="{Binding UseGermanMenuCommand}"
                                    Tag="{Binding IsGermanMenu}" Style="{StaticResource LanguageButtonStyle}"
                                    AutomationProperties.Name="Menü auf Deutsch anzeigen" />
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="5" Text="VERSION 1.2" Foreground="#56657B" FontSize="8" FontWeight="Bold"
                           Margin="24,5,0,20" TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <TextBlock Text="{Binding CurrentPageName}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EFF8F5"
                            BorderBrush="#D5EEE5" BorderThickness="1" CornerRadius="12" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Private &amp; local" Foreground="#477364" FontSize="10" FontWeight="SemiBold"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
