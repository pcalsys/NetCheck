<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="WindowTitle">NetCheck · Network diagnostics</sys:String>
    <sys:String x:Key="NavigationLabel">NAVIGATION</sys:String>
    <sys:String x:Key="DashboardMenu">Dashboard</sys:String>
    <sys:String x:Key="SpeedTestMenu">Speed test</sys:String>
    <sys:String x:Key="HistoryMenu">History</sys:String>
    <sys:String x:Key="SettingsMenu">Settings</sys:String>
    <sys:String x:Key="MenuLanguage">LANGUAGE</sys:String>
    <sys:String x:Key="UseEnglishMenuAutomation">Use English</sys:String>
    <sys:String x:Key="UseGermanMenuAutomation">Use German</sys:String>
    <sys:String x:Key="CreatorCredit">created by pcalsys</sys:String>

    <sys:String x:Key="SpeedTestAutomationName">Internet speed test</sys:String>
    <sys:String x:Key="SpeedTestEyebrow">CONNECTION PERFORMANCE</sys:String>
    <sys:String x:Key="SpeedTestTitle">How fast is this connection?</sys:String>
    <sys:String x:Key="SpeedTestSubtitle">Measure the maximum observed download and upload speed, average throughput, and latency.</sys:String>
    <sys:String x:Key="StartSpeedTest">Start speed test</sys:String>
    <sys:String x:Key="CurrentMeasurement">CURRENT MEASUREMENT</sys:String>
    <sys:String x:Key="MeasuredSpeedTitle">Your measured speed</sys:String>
    <sys:String x:Key="MeasuredSpeedSubtitle">Maximum is the fastest sustained sample observed during this run; average is the rate across the complete transfer.</sys:String>
    <sys:String x:Key="MaximumDownloadMetric">MAXIMUM DOWNLOAD</sys:String>
    <sys:String x:Key="AverageDownloadMetric">AVERAGE DOWNLOAD</sys:String>
    <sys:String x:Key="MaximumUploadMetric">MAXIMUM UPLOAD</sys:String>
    <sys:String x:Key="AverageUploadMetric">AVERAGE UPLOAD</sys:String>
    <sys:String x:Key="LatencyMetric">LATENCY</sys:String>
    <sys:String x:Key="TestDurationMetric">TEST DURATION</sys:String>
    <sys:String x:Key="TransferredDataMetric">TRANSFERRED DATA</sys:String>
    <sys:String x:Key="SpeedTestAccuracyTitle">For a useful result</sys:String>
    <sys:String x:Key="SpeedTestAccuracyText">Pause downloads and VPN traffic. Ethernet gives the clearest comparison; Wi-Fi and other devices affect the result.</sys:String>
    <sys:String x:Key="SpeedTestDataTitle">Controlled data use</sys:String>
    <sys:String x:Key="SpeedTestDataText">The test transfers up to about 210 MB through Cloudflare. Actual use adapts to your speed and is usually lower.</sys:String>
    <sys:String x:Key="SpeedTestPrivacyTitle">Private in NetCheck</sys:String>
    <sys:String x:Key="SpeedTestPrivacyText">NetCheck does not save or upload the result. Test traffic goes directly to Cloudflare's speed-test endpoints.</sys:String>

    <sys:String x:Key="DashboardAutomationName">Network diagnostics dashboard</sys:String>
    <sys:String x:Key="DashboardEyebrow">CONNECTION HEALTH</sys:String>
    <sys:String x:Key="DashboardTitle">Let’s check your connection</sys:String>
    <sys:String x:Key="DashboardSubtitle">A guided diagnosis that turns network signals into clear, practical next steps.</sys:String>
    <sys:String x:Key="Cancel">Cancel</sys:String>
    <sys:String x:Key="StartNetworkCheck">Start network check</sys:String>
    <sys:String x:Key="WorkingThroughChecks">Working through the checks…</sys:String>
    <sys:String x:Key="FixIssuesAutomation">Fix detected network issues</sys:String>
    <sys:String x:Key="Copy">Copy</sys:String>
    <sys:String x:Key="CopySummaryAutomation">Copy summary</sys:String>
    <sys:String x:Key="Export">Export</sys:String>
    <sys:String x:Key="ExportReportAutomation">Export report</sys:String>
    <sys:String x:Key="FocusedChecksTitle">8 focused checks</sys:String>
    <sys:String x:Key="FocusedChecksSubtitle">From your adapter to web access</sys:String>
    <sys:String x:Key="ControlTitle">You stay in control</sys:String>
    <sys:String x:Key="ControlSubtitle">Repairs always require your approval</sys:String>
    <sys:String x:Key="LocalResultsTitle">Results stay local</sys:String>
    <sys:String x:Key="LocalResultsSubtitle">No account or cloud upload needed</sys:String>
    <sys:String x:Key="NetworkAtGlance">Network at a glance</sys:String>
    <sys:String x:Key="NetworkAtGlanceSubtitle">The key details NetCheck used for this diagnosis</sys:String>
    <sys:String x:Key="AdapterMetric">ADAPTER</sys:String>
    <sys:String x:Key="IpAddressMetric">IP ADDRESS</sys:String>
    <sys:String x:Key="GatewayMetric">GATEWAY</sys:String>
    <sys:String x:Key="DnsServerMetric">DNS SERVER</sys:String>
    <sys:String x:Key="RecommendedNextSteps">Recommended next steps</sys:String>
    <sys:String x:Key="DiagnosticChecks">Diagnostic checks</sys:String>
    <sys:String x:Key="DiagnosticChecksSubtitle">Open a check to see the technical evidence behind it.</sys:String>

    <sys:String x:Key="HistoryAutomationName">Diagnostic history</sys:String>
    <sys:String x:Key="HistoryEyebrow">YOUR REPORTS</sys:String>
    <sys:String x:Key="HistoryTitle">A clear record of every check</sys:String>
    <sys:String x:Key="HistorySubtitle">Compare past diagnoses, revisit the evidence, or export a report when you need help.</sys:String>
    <sys:String x:Key="Refresh">Refresh</sys:String>
    <sys:String x:Key="ClearHistory">Clear history</sys:String>
    <sys:String x:Key="EmptyHistoryTitle">Your history is ready when you are</sys:String>
    <sys:String x:Key="EmptyHistoryText">Complete a network check and its diagnosis will appear here automatically. Reports stay on this computer.</sys:String>
    <sys:String x:Key="RecentDiagnostics">RECENT DIAGNOSTICS</sys:String>
    <sys:String x:Key="DiagnosisLabel">DIAGNOSIS</sys:String>
    <sys:String x:Key="ExportReport">Export report</sys:String>
    <sys:String x:Key="ExportSelectedAutomation">Export selected report</sys:String>
    <sys:String x:Key="DurationMetric">DURATION</sys:String>
    <sys:String x:Key="ChecksInReport">Checks in this report</sys:String>

    <sys:String x:Key="SettingsAutomationName">NetCheck settings</sys:String>
    <sys:String x:Key="SettingsEyebrow">ADVANCED CONFIGURATION</sys:String>
    <sys:String x:Key="SettingsTitle">Tune NetCheck to your network</sys:String>
    <sys:String x:Key="SettingsSubtitle">Adjust what gets tested and when NetCheck should flag connection quality for your attention.</sys:String>
    <sys:String x:Key="ExpertWarningTitle">For experienced users only</sys:String>
    <sys:String x:Key="ExpertWarningText">Incorrect targets or thresholds can produce misleading results. Change these settings only if you understand their effect, or restore the defaults.</sys:String>
    <sys:String x:Key="DiagnosticTargets">Diagnostic targets</sys:String>
    <sys:String x:Key="DiagnosticTargetsText">The trusted destinations NetCheck uses to confirm each layer of connectivity.</sys:String>
    <sys:String x:Key="DnsTestHostname">DNS test hostname</sys:String>
    <sys:String x:Key="DnsTestHostnameHelp">A stable public hostname used only to confirm name resolution.</sys:String>
    <sys:String x:Key="InternetPingTargets">Internet ping targets</sys:String>
    <sys:String x:Key="InternetPingTargetsHelp">Use one or more IP addresses separated by commas. Testing stops after the first response.</sys:String>
    <sys:String x:Key="WebConnectivityUrl">Web connectivity URL</sys:String>
    <sys:String x:Key="WebConnectivityUrlHelp">A lightweight endpoint that confirms web access and helps identify sign-in portals.</sys:String>
    <sys:String x:Key="QualityThresholds">Quality thresholds</sys:String>
    <sys:String x:Key="QualityThresholdsText">Choose when latency or packet loss should be called out as unstable.</sys:String>
    <sys:String x:Key="PingTimeout">Ping timeout</sys:String>
    <sys:String x:Key="PingTimeoutAutomation">Ping timeout in milliseconds</sys:String>
    <sys:String x:Key="PingTimeoutRange">500–5000 milliseconds</sys:String>
    <sys:String x:Key="StabilitySamples">Stability samples</sys:String>
    <sys:String x:Key="StabilitySamplesAutomation">Number of stability samples</sys:String>
    <sys:String x:Key="StabilitySamplesRange">3–20 requests</sys:String>
    <sys:String x:Key="PacketLossWarning">Packet-loss warning</sys:String>
    <sys:String x:Key="PacketLossAutomation">Packet-loss warning percentage</sys:String>
    <sys:String x:Key="PacketLossRange">1–100 percent</sys:String>
    <sys:String x:Key="LatencyWarning">Latency warning</sys:String>
    <sys:String x:Key="LatencyAutomation">Latency warning in milliseconds</sys:String>
    <sys:String x:Key="LatencyRange">10–2000 milliseconds</sys:String>
    <sys:String x:Key="BehaviorPrivacy">Behavior &amp; privacy</sys:String>
    <sys:String x:Key="BehaviorPrivacyText">Decide what is automatic, what is saved, and what an export may include.</sys:String>
    <sys:String x:Key="AutoRunOnLaunch">Run a diagnostic automatically when NetCheck starts</sys:String>
    <sys:String x:Key="SaveHistory">Save completed diagnostics in local history</sys:String>
    <sys:String x:Key="IncludeComputerName">Include the computer name in exported reports</sys:String>
    <sys:String x:Key="PrivacyNote">Computer names are excluded from exports by default. Reports and settings stay in your local application data folder.</sys:String>
    <sys:String x:Key="RestoreDefaults">Restore defaults</sys:String>
    <sys:String x:Key="SaveSettings">Save settings</sys:String>
</ResourceDictionary>
