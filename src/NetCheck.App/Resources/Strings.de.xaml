                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="WindowTitle">NetCheck · Netzwerkdiagnose</sys:String>
    <sys:String x:Key="NavigationLabel">NAVIGATION</sys:String>
    <sys:String x:Key="DashboardMenu">Übersicht</sys:String>
    <sys:String x:Key="SpeedTestMenu">Speedtest</sys:String>
