<UserControl x:Class="NetCheck.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="NetCheck settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,26,30,36" MaxWidth="850" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Customize diagnostic targets, thresholds, history, and report privacy."
                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnostic targets" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="DNS test hostname" FontSize="13" FontWeight="SemiBold" />
                    <TextBox Text="{Binding DnsTestHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,3"
                             AutomationProperties.Name="DNS test hostname" />
                    <TextBlock Text="A stable public hostname used only to confirm name resolution."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" />

                    <TextBlock Text="Internet ping targets" FontSize="13" FontWeight="SemiBold" />
                    <TextBox Text="{Binding PingTargets, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,3"
                             AutomationProperties.Name="Internet ping targets" />
                    <TextBlock Text="One or more IP addresses, separated by commas. NetCheck stops after the first response."
                               Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" />

                    <TextBlock Text="Web connectivity URL" FontSize="13" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ConnectivityUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,3"
                             AutomationProperties.Name="Web connectivity URL" />
                    <TextBlock Text="A lightweight endpoint used to validate web access and detect sign-in redirects."
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Quality thresholds" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
                            <TextBlock Text="Ping timeout (milliseconds)" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PingTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            <TextBlock Text="500–5000" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Stability samples" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{Binding StabilitySampleCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            <TextBlock Text="3–20" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Packet-loss warning (%)" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{Binding PacketLossWarningPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            <TextBlock Text="1–100" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Latency warning (milliseconds)" FontSize="13" FontWeight="SemiBold" />
                            <TextBox Text="{Binding LatencyWarningMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            <TextBlock Text="10–2000" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Behavior and privacy" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox Content="Run a diagnostic automatically when NetCheck starts"
                              IsChecked="{Binding AutoRunOnLaunch}" />
                    <CheckBox Content="Save completed diagnostics in local history"
                              IsChecked="{Binding SaveDiagnosticHistory}" />
                    <CheckBox Content="Include the computer name in exported reports"
                              IsChecked="{Binding IncludeComputerNameInExports}" />
                    <TextBlock Text="Computer names are redacted from exports by default. Reports and settings stay under the current user’s local application data folder."
                               Style="{StaticResource MutedTextStyle}" Margin="0,5,0,16" />

                    <Border Background="#FFF7E6" BorderBrush="#F1D69C" BorderThickness="1" CornerRadius="7"
                            Padding="11" Margin="0,0,0,16"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#7F550F" FontSize="12" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Restore defaults" Command="{Binding ResetCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Save settings" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
