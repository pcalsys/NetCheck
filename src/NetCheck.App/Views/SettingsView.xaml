<UserControl x:Class="NetCheck.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="{DynamicResource SettingsAutomationName}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,42" MaxWidth="930" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsEyebrow}" Style="{StaticResource PageEyebrowStyle}" />
                    <TextBlock Text="{DynamicResource SettingsTitle}" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{DynamicResource SettingsSubtitle}"
                               Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="#FFF7E8" BorderBrush="#E8C56E" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="#F8E6B9" VerticalAlignment="Top">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="#8A5B00"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource ExpertWarningTitle}" Foreground="#704B00"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource ExpertWarningText}" Foreground="#7D632A"
                                   FontSize="11" LineHeight="17" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="16,0,0,16" Padding="22">
                        <StackPanel>
                            <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource PrimarySoftBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource DiagnosticTargets}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,5" />
                            <TextBlock Text="{DynamicResource DiagnosticTargetsText}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,22">
                        <TextBlock Text="{DynamicResource DnsTestHostname}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding DnsTestHost, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource DnsTestHostname}" />
                        <TextBlock Text="{DynamicResource DnsTestHostnameHelp}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,16" />

                        <TextBlock Text="{DynamicResource InternetPingTargets}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PingTargets, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource InternetPingTargets}" />
                        <TextBlock Text="{DynamicResource InternetPingTargetsHelp}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,16" />

                        <TextBlock Text="{DynamicResource WebConnectivityUrl}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ConnectivityUrl, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource WebConnectivityUrl}" />
                        <TextBlock Text="{DynamicResource WebConnectivityUrlHelp}"
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="16,0,0,16" Padding="22">
                        <StackPanel>
                            <Border Width="42" Height="42" CornerRadius="13" Background="#FFF3E4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}"
                                           FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource QualityThresholds}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,5" />
                            <TextBlock Text="{DynamicResource QualityThresholdsText}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="24,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource PingTimeout}" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <TextBox Text="{Binding PingTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="11,9,50,9" AutomationProperties.Name="{DynamicResource PingTimeoutAutomation}" />
                                <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                            <TextBlock Text="{DynamicResource PingTimeoutRange}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{DynamicResource StabilitySamples}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding StabilitySampleCount, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{DynamicResource StabilitySamplesAutomation}" />
                            <TextBlock Text="{DynamicResource StabilitySamplesRange}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="{DynamicResource PacketLossWarning}" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <TextBox Text="{Binding PacketLossWarningPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="11,9,44,9" AutomationProperties.Name="{DynamicResource PacketLossAutomation}" />
                                <TextBlock Text="%" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                            <TextBlock Text="{DynamicResource PacketLossRange}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="{DynamicResource LatencyWarning}" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <TextBox Text="{Binding LatencyWarningMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="11,9,50,9" AutomationProperties.Name="{DynamicResource LatencyAutomation}" />
                                <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                            <TextBlock Text="{DynamicResource LatencyRange}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="16,0,0,16" Padding="22">
                        <StackPanel>
                            <Border Width="42" Height="42" CornerRadius="13" Background="#EAF7F4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}"
                                           FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{DynamicResource BehaviorPrivacy}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,5" />
                            <TextBlock Text="{DynamicResource BehaviorPrivacyText}"
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,22">
                        <CheckBox Content="{DynamicResource AutoRunOnLaunch}"
                                  IsChecked="{Binding AutoRunOnLaunch}" />
                        <CheckBox Content="{DynamicResource SaveHistory}"
                                  IsChecked="{Binding SaveDiagnosticHistory}" />
                        <CheckBox Content="{DynamicResource IncludeComputerName}"
                                  IsChecked="{Binding IncludeComputerNameInExports}" />

                        <Border Background="#F0F8F5" BorderBrush="#D7ECE5" BorderThickness="1" CornerRadius="10"
                                Padding="12" Margin="0,10,0,17">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}"
                                           FontSize="13" Margin="0,1,9,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource PrivacyNote}"
                                           Foreground="#4B7165" FontSize="11" LineHeight="17" />
                            </Grid>
                        </Border>

                        <Border Background="#FFF7E8" BorderBrush="#F1DCA9" BorderThickness="1" CornerRadius="10"
                                Padding="12" Margin="0,0,0,17"
                                Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyStringToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#7D5915" FontSize="11" />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource RestoreDefaults}" Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                               FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="{DynamicResource SaveSettings}" Foreground="White" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
