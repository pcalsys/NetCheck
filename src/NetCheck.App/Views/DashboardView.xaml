<UserControl x:Class="NetCheck.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             AutomationProperties.Name="{DynamicResource DashboardAutomationName}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,42" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource DashboardEyebrow}" Style="{StaticResource PageEyebrowStyle}" />
                    <TextBlock Text="{DynamicResource DashboardTitle}" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{DynamicResource DashboardSubtitle}"
                               Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,1">
                    <Button Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{DynamicResource StartNetworkCheck}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                       FontSize="15" Margin="0,0,8,0" TextWrapping="NoWrap" />
                            <TextBlock Text="{DynamicResource StartNetworkCheck}" Foreground="White" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Background="{Binding StatusOutcome, Converter={StaticResource OutcomeToTintBrushConverter}}"
                    BorderBrush="{Binding StatusOutcome, Converter={StaticResource OutcomeToBrushConverter}}"
                    BorderThickness="1" CornerRadius="17" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="15"
                            Background="{Binding StatusOutcome, Converter={StaticResource OutcomeToBrushConverter}}"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                   FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="17,1,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusSummary}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" LineHeight="20" Margin="0,5,0,0" MaxWidth="700"
                                   HorizontalAlignment="Left" />
                        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,15,0,0">
                            <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="100" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource WorkingThroughChecks}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10" />
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                                           HorizontalAlignment="Right" TextWrapping="NoWrap" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding CompletedText}" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                                   Visibility="{Binding Report, Converter={StaticResource NotNullToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                Visibility="{Binding Report, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <Button Command="{Binding FixCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="13,8" MinHeight="36" Margin="0,0,7,0"
                                Visibility="{Binding ShowFixButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{Binding FixButtonToolTip}"
                                AutomationProperties.Name="{DynamicResource FixIssuesAutomation}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,7,0" Foreground="White" />
                                <TextBlock Text="{Binding FixButtonText}" Foreground="White" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopySummaryCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="13,8" MinHeight="36" Margin="0,0,7,0" AutomationProperties.Name="{DynamicResource CopySummaryAutomation}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,7,0" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{DynamicResource Copy}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="13,8" MinHeight="36" AutomationProperties.Name="{DynamicResource ExportReportAutomation}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,7,0" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{DynamicResource Export}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#F0F4FF" BorderBrush="#CFD8FF" BorderThickness="1"
                    CornerRadius="15" Padding="20" Margin="0,0,0,24"
                    Visibility="{Binding HasRepairResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" Foreground="White"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{Binding RepairResultTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RepairResultSummary}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding RepairResult.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="StepIcon" Width="17" Height="17" CornerRadius="9"
                                                Background="{StaticResource DangerBrush}" VerticalAlignment="Top">
                                            <TextBlock x:Name="StepGlyph" Text="×" Foreground="White" FontSize="10"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                            <Setter TargetName="StepIcon" Property="Background" Value="{StaticResource SuccessBrush}" />
                                            <Setter TargetName="StepGlyph" Property="Text" Value="✓" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <controls:UniformGrid Columns="3" Margin="0,0,0,25"
                                  Visibility="{Binding Report, Converter={StaticResource NullToVisibilityConverter}}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource PrimarySoftBrush}">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource FocusedChecksTitle}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource FocusedChecksSubtitle}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="3,0" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="11" Background="#EAF7F4">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource ControlTitle}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource ControlSubtitle}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="11" Background="#FFF3E4">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}"
                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource LocalResultsTitle}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource LocalResultsSubtitle}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </controls:UniformGrid>

            <StackPanel Margin="0,0,0,25"
                        Visibility="{Binding Report, Converter={StaticResource NotNullToVisibilityConverter}}">
                <Grid Margin="0,0,0,13">
                    <TextBlock Text="{DynamicResource NetworkAtGlance}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock Text="{DynamicResource NetworkAtGlanceSubtitle}" Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <controls:UniformGrid Columns="4">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="17">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AdapterMetric}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding PrimaryAdapterName}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="2,0,4,0" Padding="17">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource IpAddressMetric}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding PrimaryIpAddress}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="4,0,2,0" Padding="17">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource GatewayMetric}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding PrimaryGateway}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="17">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DnsServerMetric}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding PrimaryDnsServer}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </controls:UniformGrid>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,25" Padding="22"
                    Visibility="{Binding HasRecommendations, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#FFF3E4" VerticalAlignment="Top">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{DynamicResource RecommendedNextSteps}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Report.Diagnosis.RecommendedActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="17" Height="17" CornerRadius="9" Background="{StaticResource PrimarySoftBrush}"
                                                VerticalAlignment="Top" Margin="0,1,0,0">
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                                       Foreground="{StaticResource PrimaryBrush}" FontSize="8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" LineHeight="20" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,13">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DiagnosticChecks}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock Text="{DynamicResource DiagnosticChecksSubtitle}"
                               Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Results.Count, Converter={StaticResource CompletedCountConverter}}"
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource DiagnosticExpanderStyle}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="11"
                                            Background="{Binding Status, Converter={StaticResource OutcomeToBrushConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}"
                                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}"
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceSubtleBrush}"
                                            CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabelConverter}}"
                                                   Foreground="{Binding Status, Converter={StaticResource OutcomeToBrushConverter}}"
                                                   FontSize="9" FontWeight="Bold" TextWrapping="NoWrap" />
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding Detail, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="175" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Duration.TotalMilliseconds, Converter={StaticResource DurationMillisecondsConverter}}"
                                           Foreground="{StaticResource SoftTextBrush}" FontSize="10" Margin="0,10,0,0" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
