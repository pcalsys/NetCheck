<Window x:Class="NetCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetCheck"
        Width="1180"
        Height="780"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,24,16,28">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="N" Foreground="White" FontSize="21" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NetCheck" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="NETWORK DIAGNOSTICS" Foreground="#8090AA" FontSize="8" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowDashboardCommand}"
                            AutomationProperties.Name="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       FontSize="18" Width="28" TextWrapping="NoWrap" />
                            <TextBlock Text="Dashboard" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowHistoryCommand}"
                            AutomationProperties.Name="Diagnostic history">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       FontSize="17" Width="28" TextWrapping="NoWrap" />
                            <TextBlock Text="History" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       FontSize="16" Width="28" TextWrapping="NoWrap" />
                            <TextBlock Text="Settings" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Margin="18,16,18,20" Padding="12" CornerRadius="8" Background="#18243A">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#4ED4A4" Margin="0,0,8,0" />
                            <TextBlock Text="READ-ONLY CHECKS" Foreground="#AAB6CA" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="NetCheck never changes your network settings."
                                   Foreground="#8090AA" FontSize="10" LineHeight="15" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <TextBlock Text="{Binding CurrentPageName}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="NetCheck 1.0" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>

