<UserControl x:Class="NetCheck.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Diagnostic history">
    <Grid Margin="30,26,30,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Diagnostic history" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Review and export reports saved on this computer."
                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="Clear history" Command="{Binding ClearCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                Visibility="{Binding HasReports, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="◷" FontSize="38" Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="NoWrap" />
                <TextBlock Text="No saved reports" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,5" />
                <TextBlock Text="Completed diagnostics will appear here when history is enabled."
                           Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding HasReports, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <ListBox ItemsSource="{Binding Reports}"
                         SelectedItem="{Binding SelectedReport}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder" Padding="13" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Diagnosis.Outcome, Converter={StaticResource OutcomeToBrushConverter}}"
                                            CornerRadius="3" Margin="0,1,0,1" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Diagnosis.Headline}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding CompletedAtUtc, StringFormat={}{0:MMM d, yyyy  HH:mm}}"
                                                   Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="Background" Value="#EDF3FF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedReport}">
                        <Grid Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding Diagnosis.Headline}" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Diagnosis.Summary}" Style="{StaticResource MutedTextStyle}"
                                           Margin="0,5,30,0" />
                            </StackPanel>
                            <Button Content="Export" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <Border Background="#F5F7FB" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="IP ADDRESS" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Network.PrimaryIpAddress}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GATEWAY" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Network.PrimaryGateway}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DURATION" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Duration.TotalSeconds, StringFormat={}{0:0.0} seconds}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Checks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="11"
                                                Background="{Binding Status, Converter={StaticResource OutcomeToBrushConverter}}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyphConverter}}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
