<UserControl x:Class="NetCheck.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:charts="clr-namespace:NetCheck.App.Controls"
             xmlns:models="clr-namespace:NetCheck.Core.Models;assembly=NetCheck.Core"
             AutomationProperties.Name="{DynamicResource MonitoringAutomationName}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,28,34,34">
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource MonitoringEyebrow}" Style="{StaticResource PageEyebrowStyle}" />
                    <TextBlock Text="{DynamicResource MonitoringTitle}" Style="{StaticResource PageTitleStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{DynamicResource MonitoringSubtitle}" Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,0" MaxWidth="650" HorizontalAlignment="Left" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="13" Padding="14,9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EEF1F5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Online}">
                                    <Setter Property="Background" Value="#EAF7F1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Degraded}">
                                    <Setter Property="Background" Value="#FFF3E4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Offline}">
                                    <Setter Property="Background" Value="#FDECEF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SoftTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Online}">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Degraded}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Offline}">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding LatestCapturedText}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10" TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource MonitoringProfileLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Label" MinHeight="40" IsEnabled="{Binding IsIdle}"
                                  AutomationProperties.Name="{DynamicResource MonitoringProfileAutomation}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="{DynamicResource MonitoringDurationLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding RunLengthChoices}" SelectedItem="{Binding SelectedRunLength}"
                                  DisplayMemberPath="Label" MinHeight="40" IsEnabled="{Binding IsIdle}"
                                  AutomationProperties.Name="{DynamicResource MonitoringDurationAutomation}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OperationStatus}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionStatusDetail}" Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{DynamicResource StartMonitoringAutomation}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource StartMonitoring}" Foreground="White" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{DynamicResource StopMonitoringAutomation}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource StopMonitoring}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <controls:UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ElapsedMetric}" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding ElapsedText}" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="17" Margin="2,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RemainingMetric}" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding RemainingText}" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="17" Margin="3,0,2,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AvailabilityMetric}" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding AvailabilityText}" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="17" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource OutagesMetric}" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock Text="{Binding OutageCountText}" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </controls:UniformGrid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource LatencyChartTitle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding LatestLatencyText}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                        </Grid>
                        <charts:LineChart Values="{Binding LatencyValues}" Stroke="{StaticResource PrimaryBrush}"
                                          Height="120" AutomationProperties.Name="{DynamicResource LatencyChartAutomation}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource JitterChartTitle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding LatestJitterText}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                        </Grid>
                        <charts:LineChart Values="{Binding JitterValues}" Stroke="{StaticResource AccentBrush}"
                                          Height="120" AutomationProperties.Name="{DynamicResource JitterChartAutomation}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource PacketLossChartTitle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding LatestPacketLossText}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource DangerBrush}" FontWeight="Bold" />
                        </Grid>
                        <charts:LineChart Values="{Binding PacketLossValues}" Stroke="{StaticResource DangerBrush}"
                                          Height="120" AutomationProperties.Name="{DynamicResource PacketLossChartAutomation}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SessionSummaryTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <controls:UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,14">
                                <TextBlock Text="{DynamicResource AverageLatencyMetric}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding AverageLatencyText}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,14">
                                <TextBlock Text="{DynamicResource MaximumLatencyMetric}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding MaximumLatencyText}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource AverageJitterMetric}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding AverageJitterText}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource OutageDurationMetric}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding OutageDurationText}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </controls:UniformGrid>
                        <TextBlock Text="{Binding IpAvailabilityText}" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0" />
                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="13" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding BaselineText}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding BaselineDetailText}" Style="{StaticResource MutedTextStyle}" FontSize="11"
                                           Margin="0,4,0,0" Visibility="{Binding HasBaseline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ConnectionEventsTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{DynamicResource NoMonitoringEvents}" Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding HasEvents, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="•" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="10"
                                                       Visibility="{Binding Detail, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10" TextWrapping="NoWrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasWindowsEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,16" />
                            <TextBlock Text="{DynamicResource CorrelatedWindowsEventsTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding WindowsEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10" TextWrapping="NoWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{DynamicResource NetworkEnvironmentTitle}" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{DynamicResource AdapterDriverLabel}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding AdapterText}" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding DriverText}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                            <TextBlock Text="{Binding IpSupportText}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,2,0,14" />
                            <TextBlock Text="{DynamicResource WifiDetailsLabel}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding WifiText}" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding WifiRatesText}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="{DynamicResource VpnFirewallLabel}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding VpnText}" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding FirewallText}" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,2,0,14" />
                            <TextBlock Text="{DynamicResource Ipv4RouteLabel}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding Ipv4RouteText}" FontSize="11" Margin="0,5,0,10" />
                            <TextBlock Text="{DynamicResource Ipv6RouteLabel}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding Ipv6RouteText}" FontSize="11" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#FFF3E4" CornerRadius="10" Padding="12" Margin="0,16,0,0"
                            Visibility="{Binding HasEnvironmentIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding EnvironmentIssueText}" Foreground="{StaticResource WarningBrush}" FontSize="10" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource PrivacyUpdatesTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource PrivacyUpdatesText}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,8" />
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Command="{Binding CreateSupportBundleCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource CreateSupportBundleAutomation}">
                            <TextBlock Text="{DynamicResource CreateSupportBundle}" TextWrapping="NoWrap" />
                        </Button>
                        <Button Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource CheckUpdatesAutomation}">
                            <TextBlock Text="{DynamicResource CheckForUpdates}" TextWrapping="NoWrap" />
                        </Button>
                        <Button Command="{Binding OpenReleaseCommand}" Style="{StaticResource TextButtonStyle}"
                                Visibility="{Binding HasReleasePage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{DynamicResource OpenReleaseAutomation}">
                            <TextBlock Text="{DynamicResource OpenReleasePage}" TextWrapping="NoWrap" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
