    <sys:String x:Key="FocusedChecksSubtitle">Vom Netzwerkadapter bis zum Webzugriff</sys:String>
    <sys:String x:Key="ControlTitle">Sie behalten die Kontrolle</sys:String>
    <sys:String x:Key="ControlSubtitle">Reparaturen erfordern immer Ihre Zustimmung</sys:String>
    <sys:String x:Key="LocalResultsTitle">Ergebnisse bleiben lokal</sys:String>
    <sys:String x:Key="LocalResultsSubtitle">Kein Konto und kein Cloud-Upload erforderlich</sys:String>
