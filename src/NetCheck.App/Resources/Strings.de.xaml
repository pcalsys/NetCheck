    <sys:String x:Key="DiagnosticChecksSubtitle">Öffnen Sie eine Prüfung, um die technischen Details anzuzeigen.</sys:String>

    <sys:String x:Key="HistoryAutomationName">Diagnoseverlauf</sys:String>
    <sys:String x:Key="HistoryEyebrow">IHRE BERICHTE</sys:String>
    <sys:String x:Key="HistoryTitle">Alle Prüfungen übersichtlich gespeichert</sys:String>
    <sys:String x:Key="HistorySubtitle">Vergleichen Sie frühere Diagnosen, prüfen Sie Details erneut oder exportieren Sie einen Bericht für den Support.</sys:String>
    <sys:String x:Key="Refresh">Aktualisieren</sys:String>
    <sys:String x:Key="ClearHistory">Verlauf löschen</sys:String>
    <sys:String x:Key="EmptyHistoryTitle">Ihr Verlauf wartet auf die erste Prüfung</sys:String>
    <sys:String x:Key="EmptyHistoryText">Führen Sie eine Netzwerkprüfung aus. Die Diagnose erscheint anschließend automatisch hier und bleibt auf diesem Computer.</sys:String>
    <sys:String x:Key="RecentDiagnostics">LETZTE DIAGNOSEN</sys:String>
    <sys:String x:Key="DiagnosisLabel">DIAGNOSE</sys:String>
    <sys:String x:Key="ExportReport">Bericht exportieren</sys:String>
    <sys:String x:Key="ExportSelectedAutomation">Ausgewählten Bericht exportieren</sys:String>
    <sys:String x:Key="DurationMetric">DAUER</sys:String>
    <sys:String x:Key="ChecksInReport">Prüfungen in diesem Bericht</sys:String>

    <sys:String x:Key="SettingsAutomationName">NetCheck-Einstellungen</sys:String>
    <sys:String x:Key="SettingsEyebrow">ERWEITERTE KONFIGURATION</sys:String>
    <sys:String x:Key="SettingsTitle">NetCheck an Ihr Netzwerk anpassen</sys:String>
    <sys:String x:Key="SettingsSubtitle">Legen Sie fest, was geprüft wird und wann NetCheck auf Verbindungsprobleme hinweisen soll.</sys:String>
    <sys:String x:Key="ExpertWarningTitle">Nur für erfahrene Benutzer</sys:String>
    <sys:String x:Key="ExpertWarningText">Falsche Ziele oder Grenzwerte können irreführende Ergebnisse verursachen. Ändern Sie diese Einstellungen nur, wenn Sie ihre Auswirkungen verstehen, oder stellen Sie die Standardwerte wieder her.</sys:String>
    <sys:String x:Key="DiagnosticTargets">Diagnoseziele</sys:String>
    <sys:String x:Key="DiagnosticTargetsText">Die vertrauenswürdigen Ziele, mit denen NetCheck jede Ebene der Verbindung prüft.</sys:String>
    <sys:String x:Key="DnsTestHostname">DNS-Testhostname</sys:String>
    <sys:String x:Key="DnsTestHostnameHelp">Ein stabiler öffentlicher Hostname, der nur zur Prüfung der Namensauflösung verwendet wird.</sys:String>
    <sys:String x:Key="InternetPingTargets">Internet-Pingziele</sys:String>
    <sys:String x:Key="InternetPingTargetsHelp">Eine oder mehrere, durch Kommas getrennte IP-Adressen. Die Prüfung endet nach der ersten Antwort.</sys:String>
    <sys:String x:Key="WebConnectivityUrl">URL für die Webverbindungsprüfung</sys:String>
    <sys:String x:Key="WebConnectivityUrlHelp">Ein schlanker Endpunkt, der den Webzugriff bestätigt und Anmeldeseiten erkennen hilft.</sys:String>
    <sys:String x:Key="QualityThresholds">Qualitätsgrenzwerte</sys:String>
    <sys:String x:Key="QualityThresholdsText">Legen Sie fest, ab wann Latenz oder Paketverlust als instabil gemeldet werden.</sys:String>
    <sys:String x:Key="PingTimeout">Ping-Zeitlimit</sys:String>
    <sys:String x:Key="PingTimeoutAutomation">Ping-Zeitlimit in Millisekunden</sys:String>
    <sys:String x:Key="PingTimeoutRange">500–5000 Millisekunden</sys:String>
    <sys:String x:Key="StabilitySamples">Stabilitätsmessungen</sys:String>
    <sys:String x:Key="StabilitySamplesAutomation">Anzahl der Stabilitätsmessungen</sys:String>
    <sys:String x:Key="StabilitySamplesRange">3–20 Anfragen</sys:String>
    <sys:String x:Key="PacketLossWarning">Paketverlustwarnung</sys:String>
    <sys:String x:Key="PacketLossAutomation">Warnschwelle für Paketverlust in Prozent</sys:String>
    <sys:String x:Key="PacketLossRange">1–100 Prozent</sys:String>
    <sys:String x:Key="LatencyWarning">Latenzwarnung</sys:String>
    <sys:String x:Key="LatencyAutomation">Latenzwarnung in Millisekunden</sys:String>
    <sys:String x:Key="LatencyRange">10–2000 Millisekunden</sys:String>
    <sys:String x:Key="BehaviorPrivacy">Verhalten und Datenschutz</sys:String>
    <sys:String x:Key="BehaviorPrivacyText">Bestimmen Sie, was automatisch geschieht, gespeichert wird und in Exporten enthalten sein darf.</sys:String>
    <sys:String x:Key="AutoRunOnLaunch">Beim Start von NetCheck automatisch eine Diagnose ausführen</sys:String>
    <sys:String x:Key="SaveHistory">Abgeschlossene Diagnosen im lokalen Verlauf speichern</sys:String>
    <sys:String x:Key="IncludeComputerName">Computernamen in exportierte Berichte aufnehmen</sys:String>
    <sys:String x:Key="PrivacyNote">Computernamen sind standardmäßig von Exporten ausgeschlossen. Berichte und Einstellungen bleiben im lokalen Anwendungsdatenordner.</sys:String>
    <sys:String x:Key="RestoreDefaults">Standardwerte wiederherstellen</sys:String>
    <sys:String x:Key="SaveSettings">Einstellungen speichern</sys:String>
